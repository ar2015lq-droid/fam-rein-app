rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Jetzt mit echtem Passwort-Login (Firebase Authentication): nur wer sich
    // erfolgreich mit Name+Passwort angemeldet hat, darf überhaupt lesen oder
    // schreiben. Das ist eine echte Absicherung auf Datenbank-Ebene, nicht nur
    // eine Prüfung in der Bedienoberfläche.

    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
